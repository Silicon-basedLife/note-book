{
  "name": "note-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "NoteApp —— 本地 Markdown 笔记应用（docs/ROADMAP.md + docs/TECH_DESIGN.md）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "build": "npm --prefix web run build",
    "dev": "npm --prefix web run dev",
    "preview": "npm --prefix web run preview",
    "typecheck": "npm --prefix web run typecheck",
    "format": "prettier --write \"web/src/**/*.ts\" \"web/scripts/**/*.mjs\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"web/*.ts\"",
    "format:check": "prettier --check \"web/src/**/*.ts\" \"web/scripts/**/*.mjs\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"web/*.ts\"",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "npm test && npm run typecheck && npm run format:check && npm run fmt:rust:check && npm run lint:rust",
    "serve:dist": "npm --prefix web run serve:dist",
    "smoke": "npm --prefix web run smoke",
    "smoke:settings": "npm --prefix web run smoke:settings",
    "tauri": "tauri",
    "kill-app": "node scripts/kill-running-app.mjs",
    "diagnose:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose-startup.ps1",
    "shortcut:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "link:webview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/link-webview-dir.ps1",
    "clean:360": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-360-leftovers.ps1",
    "sign:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-exe.ps1",
    "probe:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-ui.ps1",
    "predesktop:dev": "node scripts/kill-running-app.mjs",
    "predesktop:build": "node scripts/kill-running-app.mjs",
    "predesktop:exe": "node scripts/kill-running-app.mjs",
    "postdesktop:dev": "node scripts/postbuild-unblock.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-exe.ps1",
    "postdesktop:build": "node scripts/postbuild-unblock.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-exe.ps1",
    "postdesktop:exe": "node scripts/postbuild-unblock.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-exe.ps1",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:exe": "tauri build --no-bundle",
    "predesktop:setup": "node scripts/kill-running-app.mjs",
    "postdesktop:setup": "node scripts/postbuild-unblock.mjs",
    "desktop:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:draft": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Draft"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "prettier": "^3.9.9"
  }
}
