{
  "name": "note-app",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "NoteApp —— 本地 Markdown 笔记应用（docs/ROADMAP.md + docs/TECH_DESIGN.md）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "build": "npm --prefix web run build",
    "dev": "npm --prefix web run dev",
    "preview": "npm --prefix web run preview",
    "typecheck": "npm --prefix web run typecheck",
    "serve:dist": "npm --prefix web run serve:dist",
    "smoke": "npm --prefix web run smoke",
    "smoke:settings": "npm --prefix web run smoke:settings",
    "tauri": "tauri",
    "kill-app": "node scripts/kill-running-app.mjs",
    "diagnose:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose-startup.ps1",
    "shortcut:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "predesktop:dev": "node scripts/kill-running-app.mjs",
    "predesktop:build": "node scripts/kill-running-app.mjs",
    "predesktop:exe": "node scripts/kill-running-app.mjs",
    "postdesktop:dev": "node scripts/postbuild-unblock.mjs",
    "postdesktop:build": "node scripts/postbuild-unblock.mjs",
    "postdesktop:exe": "node scripts/postbuild-unblock.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:exe": "tauri build --no-bundle",
    "predesktop:setup": "node scripts/kill-running-app.mjs",
    "postdesktop:setup": "node scripts/postbuild-unblock.mjs",
    "desktop:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "release:draft": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1 -Draft"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
