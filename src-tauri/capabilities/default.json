{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口默认能力（窗口自适应宽度 + 侧边吸附置顶所需写入权限）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-outer-size",
    "core:window:allow-set-position",
    "core:window:allow-set-always-on-top"
  ]
}
