# EditorConfig —— 编辑器无关的基础约定（与 .gitattributes 的行尾策略保持一致）
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Windows 脚本必须 CRLF：cmd.exe 会把纯 LF 的 .bat 注释当命令执行；
# Windows PowerShell 5.1 对纯 LF 的 .ps1 在个别情况下解析异常。
[*.{bat,cmd,ps1}]
end_of_line = crlf

# Rust 由 rustfmt 决定格式（默认 4 空格）
[*.rs]
indent_size = 4

# Markdown 里"行尾两个空格"是显式换行，不能被编辑器删掉
[*.md]
trim_trailing_whitespace = false
